    {
      "name": "atomic-perception-locate-object-3d",
      "layer": "atomic",
      "path": "atomic_skills/object_locator/skills/atomic-perception-locate-object-3d/SKILL.md",
      "description": "RealSense/VLM/Grounded-SAM/depth object localization.",
      "entrypoints": [
        {
          "name": "object-locator-json",
          "path": "atomic_skills/object_locator/.venv/bin/object-locator",
          "type": "python",
          "requires_hardware": true,
          "opens_camera": true,
          "connects_robot_rpc": false,
          "moves_robot": false,
          "controls_gripper": false,
          "default_safe_to_run": false,
          "allowed_as_recovery": false,
          "execute_flag": null,
          "notes": "Live camera perception; task dry_run records a command plan instead."
        }
      ],
      "inputs_schema_ref": "schemas/common.schema.json#/definitions/DetectionResult",
      "outputs_schema_ref": "schemas/common.schema.json#/definitions/DetectionResult",
      "dependencies": [
        "RealSense",
        "OpenRouter optional",
        "calibration/extrinsics.yaml"
      ],
      "safety_gates": [
        "mode live requires HardwareGate for camera access"
      ],
      "side_effects": [
        "opens RealSense pipeline",
        "writes object_locator runs artifacts"
      ]
    },
