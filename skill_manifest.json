{
  "version": "0.1.1",
  "default_mode": "mock",
  "artifact_root_default": "/tmp/agentic_skills_runs",
  "hardware_gate": {
    "requires_hardware_allowed": true,
    "requires_execute_for_side_effects": true,
    "default_hardware_allowed": false
