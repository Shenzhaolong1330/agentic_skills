{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-skills.local/schemas/planning/graph_edge.schema.json",
  "title": "GraphEdge", "type": "object", "additionalProperties": false,
  "required": ["edge_id", "source_node_id", "target_node_id", "condition"],
  "properties": {"edge_id": {"type": "string", "minLength": 1}, "source_node_id": {"type": "string", "minLength": 1}, "target_node_id": {"type": "string", "minLength": 1}, "condition": {"type": "string", "enum": ["SUCCESS", "FAILURE", "PREDICATE_TRUE", "PREDICATE_FALSE", "DEFAULT"]}, "error_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}, "max_traversals": {"type": ["integer", "null"], "minimum": 1, "maximum": 1024}, "priority": {"type": "integer"}}
}
