{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-skills.local/schemas/state_invalidation.schema.json",
  "title": "StateInvalidation",
  "type": "object",
  "additionalProperties": false,
  "required": ["keys", "reason", "scope", "requires_reobserve"],
  "properties": {
    "keys": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "reason": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "requires_reobserve": {"type": "boolean"}
  }
}
