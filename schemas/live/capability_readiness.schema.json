    "readiness_state": {"enum": ["DISABLED", "CONTRACT_ONLY", "IMPLEMENTATION_READY", "HARDWARE_ACCEPTANCE_PENDING", "VALIDATED_READ_ONLY", "VALIDATED_ACTION", "VALIDATED_RECOVERY", "REJECTED"]},
